modules = ["nodejs-24", "python-3.11"]

[deployment]
run = ["python", "bot/main.py"]
deploymentTarget = "vm"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Sharp Money Bot"

[[workflows.workflow]]
name = "Sharp Money Bot"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python bot/main.py"

[workflows.workflow.metadata]
outputType = "console"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
ALLOWED_USER_IDS = "7245518659"

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 18999
externalPort = 3000
