modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
run = ["python", "bot/main.py"]
deploymentTarget = "vm"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Sharp Money Bot"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "full-feed-persistence"

[[workflows.workflow]]
name = "Sharp Money Bot"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "BOT_HEALTH_PORT=8099 python bot/main.py"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "full-feed-persistence"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/validate-full-feed-persistence.sh"

[workflows.workflow.metadata]
isValidation = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["nano"]

[userenv]

[userenv.shared]
UD_SLEEPER_ENABLED = "true"
ODDS_API_ENABLED = "true"
ALERT_DISABLED_SPORTS = "MLB,NFL,NBA"
ODDS_API_DAILY_LIMIT = "16"
ODDS_API_MIN_REQUEST_INTERVAL = "3600"

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 3000

[[ports]]
localPort = 8099
externalPort = 8099
