# ──────────────────────────────────────────────────────────────────────────────
# Sharp Money +EV Detection Bot — Environment Variables
# Copy this file to .env and fill in your values.
# On Replit, set these as Secrets instead of a .env file.
# ──────────────────────────────────────────────────────────────────────────────

# ── REQUIRED ──────────────────────────────────────────────────────────────────

# Your Telegram Bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ── OPTIONAL — Access Control ─────────────────────────────────────────────────

# Comma-separated list of Telegram user IDs allowed to use the bot.
# Leave empty to allow ALL users (not recommended for production).
# Find your user ID by messaging @userinfobot on Telegram.
# ALLOWED_USER_IDS=123456789,987654321

# ── OPTIONAL — Analysis Engine ────────────────────────────────────────────────

# Minimum Expected Value % to flag an opportunity (default: 3.0)
# MIN_EV_THRESHOLD=3.0

# Minimum steam score (0–100) to fire a steam alert (default: 70)
# MIN_STEAM_SCORE=70

# Minimum AI confidence score (0–100) to include in alert (default: 60)
# MIN_AI_CONFIDENCE=60

# ── OPTIONAL — Job Intervals ──────────────────────────────────────────────────

# How often to poll for new odds (seconds, default: 60)
# ODDS_POLL_INTERVAL=60

# How often to run the steam detection sweep (seconds, default: 30)
# STEAM_CHECK_INTERVAL=30

# ── OPTIONAL — External APIs (add when integrating live data) ─────────────────

# The Odds API key (https://the-odds-api.com)
# ODDS_API_KEY=

# PrizePicks API key (when available)
# PRIZEPICKS_API_KEY=

# ── OPTIONAL — Database ───────────────────────────────────────────────────────

# SQLite (default, no extra setup needed):
# DATABASE_URL=sqlite+aiosqlite:///bot/data/sharp_money.db

# PostgreSQL (for production / high volume):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/sharp_money

# ── OPTIONAL — Logging ────────────────────────────────────────────────────────

# Log level: DEBUG, INFO, WARNING, ERROR (default: INFO)
# LOG_LEVEL=INFO
